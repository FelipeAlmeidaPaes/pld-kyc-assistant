# LLM principal: Gemini, nível gratuito (ADR 0002)
GEMINI_API_KEY=
# Modelo do nível gratuito, com nome fixo (apelidos "-latest" são recusados)
GEMINI_MODEL=gemini-3.5-flash-lite
# Preço de tabela em USD por milhão de tokens, para o custo estimado (opcional)
GEMINI_PRECO_ENTRADA_USD_MILHAO=
GEMINI_PRECO_SAIDA_USD_MILHAO=

# Fallback: OpenRouter (ADR 0002)
OPENROUTER_API_KEY=
# Só modelos ":free"; outro modelo exige OPENROUTER_PERMITIR_PAGO=sim
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_PERMITIR_PAGO=nao
OPENROUTER_PRECO_ENTRADA_USD_MILHAO=
OPENROUTER_PRECO_SAIDA_USD_MILHAO=

# Banco vetorial (ADR 0004)
QDRANT_URL=http://localhost:6333

# RAG (ADR 0003, 0007 e 0009)
# Embeddings pela API do Gemini, com a mesma chave (cota gratuita de 1.000 textos por dia; vetores ficam em cache).
# Sem chave: Xenova/multilingual-e5-small (local, busca bem pior na avaliação).
EMBEDDINGS_MODELO=gemini-embedding-2
# Trechos recuperados por pergunta
RAG_K=5
# Pontuação mínima do melhor trecho para chamar o LLM; vazio desliga (calibrar na avaliação)
RAG_LIMIAR=
# "nao" desliga o fallback para o OpenRouter; a avaliação roda sem fallback
RAG_FALLBACK=sim

# Servidor HTTP
PORTA=3000
