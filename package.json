{
  "name": "pld-kyc-assistant",
  "version": "0.1.0",
  "description": "Assistente de perguntas e respostas sobre normas brasileiras de PLD/KYC, com citação obrigatória do dispositivo.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "tsx src/ingest/cli.ts",
    "indexar": "tsx src/rag/cli-indexar.ts",
    "servidor": "tsx src/rag/cli-servidor.ts",
    "avaliar": "tsx src/avaliacao/cli-avaliar.ts",
    "avaliacao:revisao": "tsx src/avaliacao/cli-revisao.ts",
    "avaliacao:experimentos": "tsx src/avaliacao/cli-experimentos-busca.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "1.5.13",
    "@langchain/qdrant": "1.0.3",
    "@langchain/textsplitters": "1.0.1",
    "@qdrant/js-client-rest": "1.19.0",
    "cheerio": "^1.2.0",
    "fastify": "5.12.5",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "7.30.0"
    }
  }
}
